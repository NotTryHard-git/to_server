# ======================= ellipse-sync: переменные окружения =======================
# Скопируйте в .env. .env НЕ коммитить.
# Секреты:  python -c "import secrets; print(secrets.token_urlsafe(32))"

ENVIRONMENT=development
ENABLE_DOCS=true

# Адрес backend внутри docker-сети (имя сервиса, не localhost)
BACKEND_BASE_URL=http://backend:8000

# sync -> back. ДОЛЖЕН СОВПАДАТЬ с INTERNAL_API_KEY в .env ellipse-back
INTERNAL_API_KEY=

# 1С -> sync. Этот ключ выдаётся специалисту 1С. ОТЛИЧАЕТСЯ от INTERNAL_API_KEY.
# Принимается как X-Api-Key, Authorization: Bearer или Basic (пароль = ключ).
SYNC_API_KEY=

# Лимиты входящего запроса от 1С
MAX_BODY_BYTES=5000000
MAX_ITEMS=2000
BACKEND_TIMEOUT=60

# Необязательно: JSON с дополнительными именами полей из 1С (см. docs/1C_INTEGRATION.md)
FIELD_ALIASES_FILE=

SENTRY_DSN=
LOG_LEVEL=INFO
