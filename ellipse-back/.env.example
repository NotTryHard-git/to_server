# ======================= ellipse-back: переменные окружения =======================
# Скопируйте в .env и заполните. .env НЕ коммитить.
# Секреты генерировать так:   python -c "import secrets; print(secrets.token_urlsafe(32))"

# development — локально; production — на сервере (приложение не запустится
# с дефолтными/слабыми секретами, localhost в CORS и т. п.)
ENVIRONMENT=development

# Swagger UI (/docs). В продакшене оставьте false.
ENABLE_DOCS=true

# --- База данных ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ellipse
POSTGRES_PASSWORD=ellipse
POSTGRES_DB=ellipse

# --- Адрес сайта (для CORS). В продакшене: ["https://example.com","https://www.example.com"] ---
CORS_ORIGINS=["http://localhost:5173"]

# --- Хранилище изображений ---
# local — файлы на диске сервера (том media_data), отдаются по /media
# s3    — Timeweb Cloud S3 или совместимое
STORAGE_BACKEND=local

# Только для local. В продакшене: https://api.example.com/media
LOCAL_STORAGE_DIR=/mnt/media
LOCAL_STORAGE_BASE_URL=http://localhost:8000/media

# Только для s3
S3_ENDPOINT_URL=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

# --- Доступы ---
# Общий секрет ellipse-sync -> ellipse-back (ТОТ ЖЕ в .env ellipse-sync)
INTERNAL_API_KEY=
# Токен администратора для POST/PATCH/DELETE: заголовок "Authorization: Bearer <токен>"
ADMIN_API_TOKEN=

# --- Синхронизация с 1С ---
MAX_SYNC_BATCH_ITEMS=2000
# all — всегда хранить сырое тело запроса от 1С (на время запуска, пока уточняется формат)
# errors — только при ошибках (по умолчанию); none — не хранить
SYNC_STORE_RAW=errors

# --- Мониторинг (необязательно) ---
SENTRY_DSN=
LOG_LEVEL=INFO

# --- Резервные копии (сервис backup) ---
BACKUP_HOUR=03          # во сколько запускать ежедневный дамп (часы, время сервера)
BACKUP_KEEP_DAYS=14     # сколько дней хранить дампы на диске
BACKUP_ON_START=0       # 1 — сделать дамп сразу при старте контейнера
# Необязательно: копия дампа в S3 (в отдельный бакет, не в тот, где картинки)
BACKUP_S3_ENDPOINT_URL=https://s3.twcstorage.ru
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_PREFIX=ellipse-db/
