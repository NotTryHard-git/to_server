# Основной домен (без www и без https://). Нужны DNS A-записи на IP сервера:
#   example.com, www.example.com, api.example.com, sync.example.com
DOMAIN=example.com

# Почта для уведомлений Let's Encrypt (если сертификат не продлится)
LETSENCRYPT_EMAIL=admin@example.com

# 1 — тестовый выпуск (staging, без лимитов, браузер не доверяет); 0 — боевой
LETSENCRYPT_STAGING=0

# Куда build-frontend.sh кладёт собранный сайт
FRONTEND_DIST_PATH=./frontend-dist
